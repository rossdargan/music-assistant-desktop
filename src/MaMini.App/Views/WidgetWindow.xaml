<Window x:Class="MaMini.App.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MaMini.App.ViewModels"
        x:Name="Self"
        Title="MA Mini"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        AutomationProperties.Name="MA Mini now playing"
        AutomationProperties.HelpText="{Binding AccessibleSummary}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border x:Name="Root"
            Margin="6"
            CornerRadius="10"
            Background="{DynamicResource Brush.Background}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            MouseLeftButtonDown="Root_MouseLeftButtonDown"
            MouseWheel="Root_MouseWheel">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.35" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="7,7,7,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Album art: click shrinks the widget to just the art (and back); drag moves it. -->
                <Button x:Name="ArtButton" Grid.Column="0" Width="52" Height="52"
                        Cursor="Hand"
                        Click="ArtButton_Click"
                        ToolTipOpening="ArtButton_ToolTipOpening"
                        PreviewMouseLeftButtonDown="ArtButton_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="ArtButton_PreviewMouseMove">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="6" Background="{DynamicResource Brush.ArtPlaceholder}" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xEC4F;" FontSize="22"
                                               Foreground="{DynamicResource Brush.Subtle}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border CornerRadius="6">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Title / artist / speaker picker. -->
                <StackPanel x:Name="DetailsPanel" Grid.Column="1" Width="168" Margin="10,0,4,0" VerticalAlignment="Center"
                            ToolTipOpening="Details_ToolTipOpening">
                    <StackPanel.ToolTip>
                        <ToolTip>
                            <StackPanel MaxWidth="320">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Artist}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding UpNext, Converter={StaticResource NullToCollapsed}}">
                                    <Run Text="Up next: " /><Run Text="{Binding UpNext, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </ToolTip>
                    </StackPanel.ToolTip>
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Foreground}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12"
                               Foreground="{DynamicResource Brush.Subtle}" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="SpeakerButton" Style="{StaticResource FlatButton}" Margin="-4,1,0,0"
                            HorizontalAlignment="Left" Click="SpeakerButton_Click"
                            ToolTip="Choose speaker"
                            AutomationProperties.Name="{Binding PlayerName, StringFormat=Speaker: {0}. Choose speaker}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F5;" FontSize="11" VerticalAlignment="Center" Margin="0,1,5,0" />
                            <TextBlock Text="{Binding PlayerName}" FontSize="11" MaxWidth="140" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="8" VerticalAlignment="Center" Margin="4,1,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Transport buttons. -->
                <StackPanel x:Name="ButtonsPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleFavoriteCommand}"
                            IsEnabled="{Binding CanFavorite}"
                            ToolTip="{Binding FavoriteTooltip}"
                            AutomationProperties.Name="{Binding FavoriteTooltip}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Content" Value="&#xEB51;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter Property="Content" Value="&#xEB52;" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Heart}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding PlayPauseCommand}"
                            IsEnabled="{Binding HasPlayer}"
                            ToolTip="{Binding PlayPauseTooltip}"
                            AutomationProperties.Name="{Binding PlayPauseTooltip}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Content" Value="&#xE768;" />
                                <Setter Property="FontSize" Value="16" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Content" Value="&#xE769;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE893;"
                            Command="{Binding NextCommand}"
                            IsEnabled="{Binding HasPlayer}"
                            ToolTip="Next track"
                            AutomationProperties.Name="Next track" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" FontSize="12"
                            Command="{Binding OpenWebUiCommand}"
                            ToolTip="Open Music Assistant"
                            AutomationProperties.Name="Open Music Assistant" />
                </StackPanel>
            </Grid>

            <!-- Thin progress bar along the bottom edge. -->
            <Grid Grid.Row="1" Height="2" Margin="10,0,10,4"
                  Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
                <Rectangle Fill="{DynamicResource Brush.ProgressTrack}" RadiusX="1" RadiusY="1" />
                <Rectangle Fill="{DynamicResource Brush.Accent}" RadiusX="1" RadiusY="1" RenderTransformOrigin="0,0">
                    <Rectangle.RenderTransform>
                        <ScaleTransform ScaleX="{Binding Progress}" />
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Grid>

            <!-- Volume overlay shown while scrolling. -->
            <Border Grid.RowSpan="2" CornerRadius="10" Background="{DynamicResource Brush.Overlay}"
                    Visibility="{Binding VolumeOverlayVisible, Converter={StaticResource BoolToVis}}"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource Brush.Foreground}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                <Setter Property="Text" Value="&#xE767;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Muted}" Value="True">
                                        <Setter Property="Text" Value="&#xE74F;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid Width="110" Height="4" Margin="10,0" VerticalAlignment="Center">
                        <Rectangle Fill="{DynamicResource Brush.ProgressTrack}" RadiusX="2" RadiusY="2" />
                        <Rectangle Fill="{DynamicResource Brush.Accent}" RadiusX="2" RadiusY="2" HorizontalAlignment="Left"
                                   Width="{Binding Volume, Converter={StaticResource PercentToWidth}, ConverterParameter=110}" />
                    </Grid>
                    <TextBlock Text="{Binding Volume}" Width="28" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Foreground}" />
                </StackPanel>
            </Border>

            <!-- Transient error message (e.g. favourite failed). -->
            <Border Grid.RowSpan="2" CornerRadius="10" Background="{DynamicResource Brush.Overlay}"
                    Visibility="{Binding Toast, Converter={StaticResource NullToCollapsed}}"
                    IsHitTestVisible="False">
                <TextBlock Text="{Binding Toast}" Foreground="{DynamicResource Brush.Foreground}" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0" />
            </Border>
        </Grid>
    </Border>
</Window>
