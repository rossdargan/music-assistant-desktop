<Window x:Class="MaMini.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MaMini.App.Controls"
        Title="MA Mini settings"
        Width="500"
        SizeToContent="Height"
        MaxHeight="760"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Save" Width="88" IsDefault="True" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" Margin="0,0,8,0" />
            <Button Content="Cancel" Width="88" IsCancel="True" Command="{Binding CancelCommand}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Connection">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Server" />
                            <TextBox Grid.Column="1" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Server address"
                                     ToolTip="e.g. http://192.168.1.10:8095 or homeassistant.local" />
                            <Button Grid.Column="2" Content="Find" Width="60" Margin="6,0,0,0" Command="{Binding FindServersCommand}"
                                    ToolTip="Search the local network for Music Assistant servers" />
                        </Grid>
                        <ComboBox Margin="90,3,0,3" ItemsSource="{Binding DiscoveredServers}"
                                  SelectedItem="{Binding SelectedDiscoveredServer}"
                                  DisplayMemberPath="Name"
                                  AutomationProperties.Name="Discovered servers"
                                  Visibility="{Binding DiscoveredServers.Count, Converter={StaticResource NullToCollapsed}}" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Token" />
                            <PasswordBox x:Name="TokenBox" Grid.Column="1" PasswordChanged="TokenBox_PasswordChanged"
                                         AutomationProperties.Name="Access token"
                                         ToolTip="Needed for Music Assistant 2.7+ with login enabled. Create one in Music Assistant under Settings → Profile." />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="90,6,0,0">
                            <Button Content="Test connection" Padding="10,2" Command="{Binding TestConnectionCommand}" />
                            <ProgressBar Width="60" Height="6" Margin="10,0,0,0" IsIndeterminate="True"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Margin="90,6,0,0" TextWrapping="Wrap" Text="{Binding ConnectionStatus}"
                                   Visibility="{Binding ConnectionStatus, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Speaker">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Speaker" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Players}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                      SelectedValue="{Binding SelectedPlayerId}" AutomationProperties.Name="Speaker" />
                        </Grid>
                        <CheckBox Content="Follow whichever speaker starts playing" IsChecked="{Binding FollowActivePlayer}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Widget">
                    <StackPanel>
                        <CheckBox Content="Always on top" IsChecked="{Binding AlwaysOnTop}" />
                        <CheckBox Content="Lock position" IsChecked="{Binding Locked}" />
                        <CheckBox Content="Album art only (click the art to shrink or expand)" IsChecked="{Binding Compact}" />
                        <CheckBox Content="Snap to screen edges" IsChecked="{Binding SnapToEdges}" />
                        <CheckBox Content="Hide while a fullscreen app is running" IsChecked="{Binding HideWhenFullscreen}" />
                        <CheckBox Content="Show progress bar" IsChecked="{Binding ShowProgress}" />
                        <CheckBox Content="Notify when the track changes" IsChecked="{Binding NotifyOnTrackChange}" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Opacity" />
                            <Slider Grid.Column="1" Minimum="40" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    Value="{Binding OpacityPercent}" AutomationProperties.Name="Opacity" />
                            <TextBlock Grid.Column="2" Text="{Binding OpacityPercent, StringFormat={}{0}%}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Theme" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Theme}" AutomationProperties.Name="Theme" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Default corner" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Corners}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding DefaultCorner}" AutomationProperties.Name="Default corner" />
                        </Grid>
                        <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Keyboard">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Media keys" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding MediaKeyModes}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding MediaKeys}" AutomationProperties.Name="Media key mode" />
                        </Grid>
                        <TextBlock Margin="90,0,0,4" TextWrapping="Wrap" Foreground="Gray" FontSize="11"
                                   Text="Smtc: integrates with Windows (recommended). Hotkey: always ours. Hook: also works when another app grabs the keys. Current: " />
                        <TextBlock Margin="90,-4,0,4" Foreground="Gray" FontSize="11" Text="{Binding MediaKeyStatus}" />
                        <CheckBox Margin="90,3,0,3" Content="Also control speaker volume with the volume keys"
                                  IsChecked="{Binding CaptureVolumeKeys}"
                                  Visibility="{Binding IsHookMode, Converter={StaticResource BoolToVis}}" />
                        <CheckBox Content="Pause Music Assistant while a Microsoft Teams call is active"
                                  IsChecked="{Binding AutoPauseOnTeamsCall}"
                                  ToolTip="Detects active audio sessions from the Teams desktop app." />
                        <CheckBox Margin="18,3,0,3" Content="Resume playback when the Teams call ends"
                                  IsChecked="{Binding AutoResumeAfterTeamsCall}"
                                  IsEnabled="{Binding IsTeamsPauseEnabled}"
                                  ToolTip="Only resumes the speaker MA Mini paused for the call, and only if you didn't change speaker or press play yourself." />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Volume step" />
                            <ComboBox Grid.Column="1" SelectedItem="{Binding VolumeStep}" AutomationProperties.Name="Volume step">
                                <ComboBox.ItemsSource>
                                    <x:Array Type="{x:Type sys:Int32}" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
                                        <sys:Int32>1</sys:Int32>
                                        <sys:Int32>2</sys:Int32>
                                        <sys:Int32>5</sys:Int32>
                                        <sys:Int32>10</sys:Int32>
                                    </x:Array>
                                </ComboBox.ItemsSource>
                            </ComboBox>
                        </Grid>
                        <TextBlock Margin="0,8,0,2" FontWeight="SemiBold" Text="Global shortcuts (click, then press keys; Backspace clears)" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Show/hide widget" />
                            <controls:HotkeyBox Grid.Column="1" Text="{Binding HotkeyToggleWidget, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Show or hide widget shortcut" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Play/pause" />
                            <controls:HotkeyBox Grid.Column="1" Text="{Binding HotkeyPlayPause, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Play pause shortcut" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Next track" />
                            <controls:HotkeyBox Grid.Column="1" Text="{Binding HotkeyNext, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Next track shortcut" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Favourite" />
                            <controls:HotkeyBox Grid.Column="1" Text="{Binding HotkeyFavorite, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Favourite shortcut" />
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
